# Copy to .env and adjust. Every value has a safe default for local dev.

PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/career?sslmode=disable
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=72

# File + vector storage (created automatically).
STORAGE_DIR=./data/uploads
VECTOR_DIR=./data/vectors
MIGRATION_DIR=./migrations
SEED_FILE=./seed/roles.json

# LLM: leave as "mock" to run with zero external dependencies.
# Set LLM_PROVIDER to "anthropic" or "openai" and provide a key to use a real model.
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
