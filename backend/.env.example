# Copy to .env and adjust. Defaults run locally with the mock model.

PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/career?sslmode=disable
REDIS_URL=redis://localhost:6379/0
WORKFLOW_STATE_TTL_MINUTES=60
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=72

STORAGE_DIR=./data/uploads
VECTOR_DIR=./data/vectors
MIGRATION_DIR=./migrations
SEED_FILE=./seed/roles.json

# AI provider: mock | gemini | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Gemini example:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.7-flash
# LLM_API_KEY=your_gemini_api_key
